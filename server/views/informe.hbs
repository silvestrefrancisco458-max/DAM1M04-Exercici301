{{> header}}

<h2>{{subtitle}}</h2>

<ul>
  {{#each cities}}
    <li>
      <strong>{{name}}</strong>
      ({{lookup ../countrie country}}) —
      {{#if population}}
        {{population}} habitants —
        {{#if coastal}}🌊 Costanera{{else}}Interior{{/if}} —
        {{#if (lte population 800000)}}Petita{{else}}Gran{{/if}}
      {{else}}
        <em>Població desconeguda</em>
      {{/if}}
    </li>
  {{/each}}
</ul>

{{> footer}}